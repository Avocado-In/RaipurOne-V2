# Smart Grievance local environment
APP_ENV=development
DEBUG=true
STORAGE_MODE=memory
AUTH_MODE=demo
AI_PROVIDER=rule_based
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
REACT_APP_API_URL=http://127.0.0.1:8000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
TELEGRAM_BOT_TOKEN=

# Auth
JWT_SECRET=
REQUIRE_AUTH=true

# Worker app proof-of-work rules (see backend/README.md)
# How close to a complaint's own coordinates a worker must stand to submit. Only
# enforced when the complaint has coordinates at all.
WORK_GEOFENCE_METRES=300
# Reject a GPS fix vaguer than this - it is not evidence the worker was on site.
WORK_MAX_GPS_ACCURACY_METRES=200
# Reject photos older than this, so gallery pictures cannot stand in for the job.
WORK_PHOTO_MAX_AGE_MINUTES=60
